# Copy this file to .env.local for local development, and add the same
# two variables in your Vercel project's Settings -> Environment Variables
# for production.
#
# Without these set, the contact form still works end-to-end (validation,
# honeypot, rate limiting) but logs the submission to the server console
# instead of actually sending an email — see lib/contact.ts.

RESEND_API_KEY=
RESEND_TO_EMAIL=
